# Secrets the supervisor reads from the environment. Copy to .env for a local run, or list the same
# names in Harbormaster's environment_file. Everything else the supervisor needs is a file under
# DATA_DIR, not an environment variable: config.json (copied from config.example.json), the SSH key,
# and the advisor auth.json.
OLLAMA_API_KEY=
TELEGRAM_BOT_TOKEN=
CARD_NUMBER=
CARD_EXPIRY=
CARD_CVC=
CARD_NAME=
